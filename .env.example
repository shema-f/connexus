# Connexus — environment variables
# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL (used for SEO, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session/auth secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# Admin credentials for the /admin dashboard (seeded on first run)
ADMIN_EMAIL=admin@ferrivox.com
ADMIN_PASSWORD=change-me-strong-password

# Contact / company info (rendered on contact page & footer)
NEXT_PUBLIC_CONTACT_EMAIL=hello@ferrivox.com

# Transactional email provider (optional — set to enable email workflows)
EMAIL_API_KEY=
EMAIL_FROM=

# S3-compatible storage (optional)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Analytics (optional, privacy-respecting)
NEXT_PUBLIC_ANALYTICS_ID=

# Connexus Bot AI (optional) — when set, the /api/assistant endpoint grounds an
# OpenAI-compatible chat API with the local knowledge base. Leave empty to use
# the purely local keyword-retrieval bot (no internet, no data leaves server).
CONNEXUS_AI_API_URL=
CONNEXUS_AI_API_KEY=
CONNEXUS_AI_MODEL=gpt-4o-mini
